<?xml version='1.0' encoding='utf-8'?>
<addons>
    <addon id="repository.mdblist" name="MDBList Kodi Repository" version="1.0.0" provider-name="MDBList">
        <extension point="xbmc.addon.repository" name="MDBList Kodi Repository">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/linaspurinis/repository.mdblist/main/repo/zips/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/linaspurinis/repository.mdblist/main/repo/zips/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/linaspurinis/repository.mdblist/main/repo/zips/</datadir>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en">MDBList Kodi add-ons</summary>
            <description lang="en">Repository for MDBList add-ons for Kodi.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
    <addon id="service.mdblist-scrobbler" name="MDBList" version="1.3.0" provider-name="MDBList">
        <requires>
            <import addon="xbmc.python" version="3.0.1" />
            <import addon="script.module.requests" version="2.22.0" />
        </requires>
        <extension point="xbmc.service" library="service.py" />
        <extension point="xbmc.python.script" library="script.py" />
        <extension point="xbmc.python.pluginsource" library="plugin.py">
            <provides>video</provides>
        </extension>
        <extension point="kodi.context.item">
            <menu id="kodi.core.main">
                <item library="resources/lib/watchlist_context.py" args="add">
                    <label>Add to MDBList watchlist</label>
                    <visible>String.IsEqual(ListItem.dbtype,movie) | String.IsEqual(ListItem.dbtype,tvshow) | String.IsEqual(ListItem.dbtype,episode)</visible>
                </item>
            </menu>
        </extension>
        <extension point="xbmc.addon.metadata">
            <platform>all</platform>
            <summary lang="en">MDBList Scrobbler &amp; Sync</summary>
            <description lang="en">Track watched TV shows and movies with MDBList scrobble endpoints, and two-way sync watched status, ratings, and library/collection with MDBList</description>
            <website>https://mdblist.com</website>
            <source>https://github.com/linaspurinis/kodi-mdblist-scrobbler</source>
            <assets>
                <icon>icon.png</icon>
                <fanart>mdblist-kodi.png</fanart>
            </assets>
        </extension>
    </addon>
</addons>